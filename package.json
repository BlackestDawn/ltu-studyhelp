{
  "name": "ltu-studyhelp",
  "description": "Networks Midterm Workbench: practice labs for Computer Networking (Kurose & Ross, 8th ed.)",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun build --target=bun --production --public-path=/ --outdir=dist src/server.ts",
    "start": "cd dist && NODE_ENV=production bun server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.3.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.8.3"
  }
}
